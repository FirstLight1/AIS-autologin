{
  "manifest_version": 3,
  "name": "AiS Auto-Login",
  "version": "1.0",
  "description": "Securely auto-login to Stuba.sk with encrypted credential storage. Open source and privacy-focused.",
  "author": "Lukáš Kamen",
  "homepage_url": "https://github.com/FirstLight1/AIS-autologin",
  "browser_specific_settings": {
    "gecko": {
      "id": "ais-autologin@lukaskamen.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://idp.stuba.sk/*", "*://is.stuba.sk/auth/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://idp.stuba.sk/*", "*://is.stuba.sk/auth/*"],
      "js": ["content.js"]
    }
  ]
}
